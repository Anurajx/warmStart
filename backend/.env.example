# Warmstart backend environment
# Copy to `.env` and fill in. All variables are optional except the API key
# needed for live OpenAI calls.

# OpenAI (required for live pipeline + LLM judge). Standard OPENAI_API_KEY is
# also honoured as a fallback.
WARMSTART_OPENAI_API_KEY=sk-...
# WARMSTART_OPENAI_BASE_URL=https://api.openai.com/v1

# Redis Stack (Redis Search + Vector Search modules). Matches docker-compose.yml.
WARMSTART_REDIS_URL=redis://localhost:6379/0

# Providers
WARMSTART_EMBEDDING_MODEL=text-embedding-3-small
WARMSTART_EMBEDDING_DIMENSIONS=1536
WARMSTART_LLM_MODEL=gpt-4o-mini
WARMSTART_JUDGE_MODEL=gpt-4o-mini

# Cache behaviour
WARMSTART_SEMANTIC_SIMILARITY_THRESHOLD=0.88
WARMSTART_CACHE_TTL_SECONDS=86400
WARMSTART_VECTOR_KNN_RESULTS=3

# Pricing (USD per 1M tokens) used for cost metrics
WARMSTART_INPUT_TOKEN_PRICE_PER_1M=0.15
WARMSTART_OUTPUT_TOKEN_PRICE_PER_1M=0.60
WARMSTART_EMBEDDING_TOKEN_PRICE_PER_1M=0.02

# Vector index name and key prefix
WARMSTART_REDIS_INDEX_NAME=idx:warmstart_vectors
WARMSTART_REDIS_KEY_PREFIX=warmstart

# Optional: host the Next.js dashboard on a different origin
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO